  inquiryType String?
  message     String
  status      ContactLeadStatus @default(new)
  sourcePage  String?
  ipAddress   String?
  userAgent   String?
  adminNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum PaymentStatus {
  pending
  paid
  failed
}

/// Online payments from the public /payment page (Razorpay). Status is synced
/// from Razorpay on return and via webhook; listed in admin under Payments.
model Payment {
  id               String        @id @default(cuid())
  /// Razorpay's own order id (order_XXXXXXXXXXXXXX); also the invoice number.
  orderId          String        @unique
  status           PaymentStatus @default(pending)
  amount           Decimal
  currency         String
  customerName     String
  customerEmail    String
  customerPhone    String
  tutorId          String?
  tutorName        String?
  note             String?
  /// Razorpay payment id (pay_...). Column name kept from the Cashfree era so no migration is needed.
  gatewayPaymentId String?       @map("cfPaymentId")
  paymentMethod    String?
  bankReference    String?
  paidAt           DateTime?
  ipAddress        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
}

/// A direct student <-> tutor thread. Opened when a demo is confirmed and made
/// permanent once the student pays; the tutor can close it again.
model Conversation {
  id            String    @id @default(cuid())
  studentId     String
  tutorId       String
  /// "active" | "closed" — closed hides it from the student and blocks new messages.
  status        String    @default("active")
  /// Survives demo cancellation once the student has paid for this tutor.
  permanent     Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  student       User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor         User      @relation("ConversationTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @default("")
  /// "text" | "image" | "file" | "audio" | "meet" | "system" — drives how the bubble renders.
  kind           String       @default("text")
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  /// Extra payload per kind: a meet card keeps { link, startsAt, minutes } here.
  meta           Json?
  /// The message this one is a reply to; the bubble shows a quote of it.
  replyToId      String?
  /// Set when the sender unsends it. The row stays so the thread keeps its order.
  deletedAt      DateTime?
  /// Set when the other party opens the thread; drives unread counts and email nudges.
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model FaqItem {
