// ============================================================================
// Phase 1A — staff identity, scoped access, and the audit spine.
//
// Everything below is ADDITIVE: new models plus back-relations on User (which
// add no column, because the foreign key lives on the new side). No existing
// field changes type, nullability or name, so `prisma db push` cannot drop or
// rewrite production data.
//
// This replaces the env-var + local-JSON admin store in
// src/app/admin/_lib/admin-users.ts, which could not attribute an action to a
// person, scope anyone to a city, or grant one capability without granting all.
// ============================================================================

/// L0 owner … L4 viewer. The level sets the ceiling; grants open specific doors.
enum StaffLevel {
  owner
  lead
  manager
  operator
  viewer
}

/// One row per person who signs into any back-office surface.
model StaffMember {
  id           String     @id @default(cuid())
  userId       String     @unique
  level        StaffLevel @default(viewer)
  jobTitle     String?
  reportsToId  String?
  photoUrl     String?
  /// "active" | "paused" | "offboarded"
  status       String     @default("active")
  /// Set by "I'm on duty today"; routing skips people who are off duty.
  onDutyUntil  DateTime?
  queuePaused  Boolean    @default(false)
  density      String     @default("cozy")
  lastSeenAt   DateTime?
  offboardedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user             User              @relation("StaffIdentity", fields: [userId], references: [id], onDelete: Cascade)
  reportsTo        StaffMember?      @relation("StaffReports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports          StaffMember[]     @relation("StaffReports")
  grants           StaffGrant[]
  scopes           StaffScope[]
  memberships      TeamMember[]
  ledTeams         Team[]            @relation("TeamLead")
  savedViews       SavedView[]
  bulkOps          BulkOperation[]
  exportRequests   ExportRequest[]
  scheduledReports ScheduledReport[]
  macros           Macro[]

  @@index([status])
  @@index([level])
  @@index([reportsToId])
}

/// A single capability granted on top of a level. Always carries a written
/// reason, so an access review can ask "why does this person have this?".
model StaffGrant {
  id         String    @id @default(cuid())
  staffId    String
  capability String
  grantedBy  String
  reason     String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, capability])
  @@index([capability])
  @@index([expiresAt])
}

/// Where a person may act. No scope rows means unscoped (owner/lead).
model StaffScope {
  id        String    @id @default(cuid())
  staffId   String
  /// "country" | "state" | "city" | "area" | "team"
  kind      String
  refId     String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, kind])
  @@index([kind, refId])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  leadId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    StaffMember? @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members TeamMember[]
}

model TeamMember {
  id       String    @id @default(cuid())
  teamId   String
  staffId  String
  role     String    @default("member")
  joinedAt DateTime  @default(now())
  // Dated assignment, like StaffScope: leaving a team ends the membership
  // rather than deleting it, so "who was on this team in March" stays
  // answerable and the audit trail keeps pointing somewhere.
  leftAt   DateTime?

  team  Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Not unique on (teamId, staffId): someone can leave a team and rejoin it,
  // which would collide with a plain unique. Uniqueness of the CURRENT
  // membership is enforced in addTeamMember instead.
  @@index([teamId, leftAt])
  @@index([staffId])
}

/// Every page view inside /admin. Answers "what was this person looking at?".
model ActivityLog {
  id         String   @id @default(cuid())
  staffId    String?
  userId     String?
  path       String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([staffId, createdAt])
  @@index([createdAt])
}

/// Sign-in, sign-out, lockout, impersonation. Separate from AuditLog because
/// these are not mutations and must survive a user row being deleted.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  /// "login" | "logout" | "lockout" | "impersonate.start" | "impersonate.end" | "denied"
  kind      String
  /// "ok" | "failed"
  outcome   String
  ipAddress String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@index([email])
}

/// Every unmasking of a phone, email or document, with the reason given.
model RevealLog {
  id          String   @id @default(cuid())
  staffId     String
  subjectType String
  subjectId   String
  field       String
  reason      String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([staffId, createdAt])
  @@index([subjectType, subjectId])
}

/// Every CSV that leaves the building, and who approved it.
model ExportLog {
  id           String    @id @default(cuid())
  staffId      String
  surface      String
  filters      Json?
  rowCount     Int
  containsPii  Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([surface])
}

// ---------------------------------------------------------------------------
// Phase 2 — the ledger: saved views, bulk operations with undo, export
// approval, and scheduled reports.
// ---------------------------------------------------------------------------

/// A named, shareable table configuration: the filters, columns, sort and
/// density that reproduce a given view of a surface. `workOrder` turns a view
/// into a queue with a next-item mode.
model SavedView {
  id        String   @id @default(cuid())
  staffId   String
  /// The table this view belongs to, e.g. "leads", "tutors", "payments".
  surface   String
  name      String
  /// Typed filter clauses; shape owned by _ui/ledger-filters.ts.
  filters   Json     @default("[]")
  /// Column keys in display order. Empty means the surface default.
  columns   Json     @default("[]")
  /// Serialised multi-sort, e.g. "createdAt:desc,name:asc".
  sort      String?
  /// "cozy" | "compact"
  density   String   @default("cozy")
  /// Visible to the owner's team rather than only to them.
  shared    Boolean  @default(false)
  /// Pinned to the rail with a live count.
  pinned    Boolean  @default(false)
  /// Worked top to bottom as a queue instead of browsed as a table.
  workOrder Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   StaffMember       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reports ScheduledReport[]

  @@unique([staffId, surface, name])
  @@index([surface, shared])
  @@index([staffId, pinned])
}

/// One bulk action over many rows. Holds enough to undo itself for 7 days.
model BulkOperation {
  id            String    @id @default(cuid())
  staffId       String
  surface       String
  /// Dotted verb matching the audit action, e.g. "lead.assign".
  action        String
  /// Required. Copied onto every audit row the operation writes.
  reason        String
  /// The filter the rows were selected by, for "select all matching".
  filters       Json?
  totalRows     Int       @default(0)
  succeeded     Int       @default(0)
  failed        Int       @default(0)
  /// "running" | "done" | "failed" | "undone"
  status        String    @default("running")
  /// Undo is refused past this instant, so the window cannot be argued about.
  undoableUntil DateTime
  undoneAt      DateTime?
  undoneById    String?
  createdAt     DateTime  @default(now())

  staff StaffMember        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  rows  BulkOperationRow[]

  @@index([staffId, createdAt])
  @@index([status, undoableUntil])
}

/// The per-row record of a bulk action. `beforeJson` is what undo restores.
model BulkOperationRow {
  id          String   @id @default(cuid())
  operationId String
  entityType  String
  entityId    String
  /// Exact prior state of the fields the action touched.
  beforeJson  Json?
  afterJson   Json?
  /// "ok" | "failed" | "skipped" | "restored"
  status      String   @default("ok")
  error       String?
  createdAt   DateTime @default(now())

  operation BulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, status])
  @@index([entityType, entityId])
}

/// An export that needs sign-off before it runs: over the row threshold, or
/// containing PII. Approving it is itself an audited, reason-gated action.
model ExportRequest {
  id           String    @id @default(cuid())
  staffId      String
  surface      String
  filters      Json?
  /// Column keys the export would contain.
  columns      Json      @default("[]")
  rowCount     Int
  containsPii  Boolean   @default(false)
  /// "csv" | "xlsx"
  format       String    @default("csv")
  /// Why this data is needed. Required.
  reason       String
  /// "pending" | "approved" | "denied" | "fulfilled" | "expired"
  status       String    @default("pending")
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  /// Approval lapses, so a stale one cannot be redeemed months later.
  expiresAt    DateTime
  fulfilledAt  DateTime?
  createdAt    DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([staffId, createdAt])
}

/// A saved view mailed out on a schedule.
model ScheduledReport {
  id          String    @id @default(cuid())
  savedViewId String
  staffId     String
  name        String
  /// "daily" | "weekly" | "monthly"
  cadence     String    @default("weekly")
  /// Hour of day in IST, 0-23, when the report is sent.
  sendHour    Int       @default(8)
  /// 0 = Sunday. Only read for the weekly cadence.
  sendWeekday Int       @default(1)
  /// Email addresses. Validated on write.
  recipients  Json      @default("[]")
  format      String    @default("csv")
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  lastError   String?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  savedView SavedView   @relation(fields: [savedViewId], references: [id], onDelete: Cascade)
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@index([staffId])
}

/// A named bundle of field changes an operator fires from the toolbar or the
/// bulk bar — "Demo no-show": set stage, add a note, assign to me.
///
/// Phase 2 ships layer 1 only: set-field and add-note actions, applied through
/// the same bulk runner as any other bulk action, so a macro run is previewed,
/// reasoned, audited and undoable exactly like a hand-made one. The richer
/// trigger/condition engine is Phase 6.
model Macro {
  id          String    @id @default(cuid())
  name        String
  surface     String
  /// MacroAction[] — validated on write by _lib/macros.ts, never trusted on read.
  actions     Json      @default("[]")
  /// Optional territory limit, mirroring StaffScope.
  scopeKind   String?
  scopeRef    String?
  createdById String
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy StaffMember @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([surface, name])
  @@index([surface, enabled])
}

// ---------------------------------------------------------------------------
// Phase 3 — People: the 360° record, families, verification, document access.
// ---------------------------------------------------------------------------

/// A household. Lets one parent pay for, and see, several children.
///
/// Absent until now: every student stood alone, so a parent with two children
/// had two unrelated logins and no way to see both.
model Family {
  id               String   @id @default(cuid())
  name             String
  /// Denormalised for the ledger; the authoritative list is `members`.
  primaryContactId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members  FamilyMember[]
  consents ConsentRecord[]

  @@index([name])
}

/// One person's place in a family. `role` separates who pays from who learns.
model FamilyMember {
  id        String    @id @default(cuid())
  familyId  String
  userId    String
  /// "parent" | "student" | "guardian"
  role      String    @default("student")
  /// May see and act on the whole family's records.
  isPrimary Boolean   @default(false)
  /// Dated, like StaffScope and TeamMember: leaving a family is recorded,
  /// never deleted, so a payment made while a member stays explainable.
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation("FamilyMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, leftAt])
  @@index([userId])
}

/// A recorded consent, for DPDP. Who consented, to what, when, and from where.
model ConsentRecord {
  id        String    @id @default(cuid())
  userId    String?
  familyId  String?
  /// "marketing" | "recording" | "data-processing" | "parent-for-minor"
  kind      String
  granted   Boolean
  /// The exact wording shown at the time. Consent to text nobody kept is not
  /// consent you can demonstrate later.
  statement String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  /// Set when withdrawn; the row is never deleted.
  revokedAt DateTime?

  user   User?   @relation("ConsentUser", fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([familyId, kind])
}

/// The verification desk's queue: one row per document submitted for review.
model TutorVerification {
  id           String    @id @default(cuid())
  tutorId      String
  /// "id-front" | "id-back" | "degree" | "address" | "other"
  kind         String
  /// Storage key, NOT a public URL. Served only through the authenticated
  /// document route, which is the whole point of this table.
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  /// "pending" | "approved" | "rejected" | "more-needed"
  status       String    @default("pending")
  /// Required on reject and on more-needed; shown to the tutor.
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tutor Tutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  views DocumentView[]

  @@index([status, createdAt])
  @@index([tutorId, kind])
}

/// Every time somebody looked at a document.
///
/// Separate from RevealLog because a document is not a field: this records
/// opening a scan of someone's passport, which is a heavier act than
/// unmasking a phone number and deserves its own trail.
model DocumentView {
  id             String   @id @default(cuid())
  verificationId String
  staffId        String
  /// Written at the time, so the trail survives the staff record being renamed.
  staffLabel     String
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  verification TutorVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, createdAt])
  @@index([staffId, createdAt])
}

/// A tutor's computed quality band, stored so the ledger can sort by it.
///
/// Recomputed rather than maintained incrementally: the inputs change for
/// reasons unrelated to the tutor (a review lands, a demo converts), and an
/// incrementally-updated score drifts from its inputs with no way to notice.
model TutorQuality {
  tutorId           String   @id
  /// 1–7. Never 0 and never 8 — a band outside the strip renders as nothing.
  band              Int      @default(1)
  score             Float    @default(0)
  verificationScore Float    @default(0)
  completenessScore Float    @default(0)
  responseScore     Float    @default(0)
  conversionScore   Float    @default(0)
  attendanceScore   Float    @default(0)
  reviewScore       Float    @default(0)
  complaintPenalty  Float    @default(0)
  /// Which inputs were missing when this was computed, so a low band caused by
  /// absent data is distinguishable from one caused by poor performance.
  missingInputs     Json     @default("[]")
  computedAt        DateTime @default(now())

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([band])
  @@index([score])
}
