}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@index([sortOrder])
}

model BlogPost {
  id                 String        @id @default(cuid())
  slug               String        @unique
  /// Country segment for the public URL: null -> /blog/<slug>, "uae" -> /blog/uae/<slug>.
  /// Nullable on purpose so the 119 posts that predate this keep their existing URLs.
  country            String?
  /// Optional city within that country, for city-level blog taxonomy in admin.
  city               String?
  title              String
  excerpt            String?
  body               String
  authorName         String?
  categoryId         String?
  featuredImageId    String?
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String[]      @default([])
  ogImageAssetId     String?
  schemaJson         Json?
  tags               String[]      @default([])
  status             ContentStatus @default(draft)
  indexFlag          IndexFlag     @default(auto)
  readingTimeMinutes Int?
  viewCount          Int           @default(0)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage      Asset?        @relation("BlogFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  ogImage            Asset?        @relation("BlogOgImage", fields: [ogImageAssetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([country])
}

model Job {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  department        String
  location          String
  employmentType    String
  level             String?
  workMode          String?
  summary           String?
  roleOverview      String?
  jobDescription    String
  responsibilities  String[]         @default([])
  requirements      String[]         @default([])
  niceToHave        String[]         @default([])
  benefits          String[]         @default([])
  applicationPrompt String?
  status            JobStatus        @default(draft)
  sortOrder         Int              @default(0)
  publishedAt       DateTime?
  closesAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  applications      JobApplication[]

  @@index([status])
  @@index([department])
  @@index([publishedAt])
  @@index([sortOrder])
}

model JobApplication {
  id                   String               @id @default(cuid())
  jobId                String?
  jobTitleSnapshot     String
  status               JobApplicationStatus @default(received)
  firstName            String
  lastName             String
  email                String
  phone                String?
  currentLocation      String?
  currentRole          String?
  experienceYears      Int?
  noticePeriod         String?
  expectedCompensation String?
  linkedInUrl          String?
  portfolioUrl         String?
  resumeUrl            String?
  resumeFilename       String?
  resumeMimeType       String?
  resumeSizeBytes      Int?
  photoUrl             String?
  photoFilename        String?
  photoMimeType        String?
  photoSizeBytes       Int?
  coverLetter          String?
  answersJson          Json?
  consentAccepted      Boolean              @default(false)
  adminNotes           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
