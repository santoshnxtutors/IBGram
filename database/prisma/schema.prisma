// Phase 2 — Marketing/CMS models (additive, no schema breaking changes)
// ─────────────────────────────────────────────────────────────────────────────

enum ContentStatus {
  draft
  review
  published
  archived
}

enum JobStatus {
  draft
  published
  closed
  archived
}

enum JobApplicationStatus {
  received
  reviewing
  shortlisted
  rejected
  hired
  withdrawn
}

enum TestimonialKind {
  review
  success_story
}

model Testimonial {
  id            String          @id @default(cuid())
  kind          TestimonialKind @default(review)
  authorName    String
  authorRole    String?
  location      String?
  rating        Int?
  quote         String
  longStory     String?
  curriculum    Curriculum?
  imageAssetId  String?
  status        ContentStatus   @default(published)
  useOnHomepage Boolean         @default(false)
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)
  verifiedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  imageAsset    Asset?          @relation("TestimonialImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([useOnHomepage])
  @@index([featured])
  @@index([curriculum])
}

model SuccessStory {
  id           String        @id @default(cuid())
  studentName  String
  subject      String?
