# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Amazon SES)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IBGram <noreply@ibgram.com>"
MAIL_REPLY_TO=support@ibgram.com

# --- Cloudflare Turnstile (bot protection on public signup) -----------------
# Both optional. With no secret the backend skips captcha verification and the
# widget renders nothing, so signup still works - the honeypot and the register
# rate limit below stay in force either way.
# Get a key pair at: Cloudflare dashboard -> Turnstile -> Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Registration is a once-per-person action, so it gets a far tighter limit than
# login. Defaults to 3 per hour per IP when unset.
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=3
